PORT=3001
CORS_ORIGIN=http://localhost:3000

# Must be identical to JWT_SECRET in apps/web/.env.local
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_EXPIRES_IN=1h

# Credentials of the seeded demo users (usr_1 gets this email, usr_2 is anna@example.com)
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=password123

# Postgres from the root docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings?schema=public

# Where uploaded meeting files are stored; relative paths resolve from apps/api
FILES_DIR=.files
