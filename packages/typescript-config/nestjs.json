{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Nest.js",
  "extends": "./base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "resolvePackageJsonExports": true,
    "sourceMap": true,
    "removeComments": true,
    "outDir": "./dist"
  }
}
